# Copy to .env.local for local development. Never commit real secrets.
# In Azure these values come from Key Vault.

# Postgres (docker compose service "postgres").
# The app connects as agentcore_app, which cannot bypass row-level security.
DATABASE_URL=postgres://agentcore_app:agentcore_app@localhost:5433/agentcore
# Migrations run as the owner role (not a superuser, as in Azure). Only `pnpm db:migrate`,
# `pnpm db:set-context-key` and tests use this.
DATABASE_ADMIN_URL=postgres://agentcore_owner:agentcore_owner@localhost:5433/agentcore
# Signs the tenant set on each transaction, so injected SQL cannot switch tenant.
# Base64, at least 32 bytes. This value is for local development only; in Azure the key
# comes from Key Vault. Generate one with: openssl rand -base64 32
TENANT_CONTEXT_KEY=hvGbAchRJxTDr44wRf2cGBUcFqkmoOlGjn7gn7fVsjs=

# Temporal dev server (docker compose service "temporal"; web UI on http://localhost:8233)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Temporal Cloud only (connects with TLS when set). In Azure it comes from Key Vault.
TEMPORAL_API_KEY=
# Task queue the web app sends jobs to and the worker takes them from.
JOB_TASK_QUEUE=documents
# The agent every upload runs (a folder under agents/). Optional; defaults to contract-summary.
# AGENT_FOR_UPLOADS=contract-summary
# Where the agents are. Optional; by default the nearest agents/ folder above the working directory.
# AGENTS_DIR=
# Tests only: lets a job ask the placeholder agent to fail on purpose. The worker
# refuses it unless Temporal and the database are local. Never set it in Azure.
ALLOW_TEST_FAULTS=false        # tests only: forced job failures, and a failing page at /test/error

# In Azure the app uses AZURE_STORAGE_ACCOUNT_URL and its managed identity
# (AZURE_CLIENT_ID) instead of a connection string.
# Azurite (docker compose service "azurite"). This is Azurite's public, well-known
# development account key, not a secret.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;

# Largest document a tenant can upload, in MB (PDF or Word).
MAX_UPLOAD_MB=25
# Uploads per tenant in a rolling 24 hours (each costs model calls); default 500.
# MAX_UPLOADS_PER_TENANT_PER_DAY=500

# Sign-in (Auth.js). AUTH_SECRET encrypts session cookies: this value is public and
# only accepted when AUTH_URL is local; in Azure it comes from Key Vault.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=local-dev-only-auth-secret-do-not-use-in-azure-0001
AUTH_URL=http://localhost:3000

# Microsoft Entra ID: the client's multi-tenant app registration. Leave empty to hide
# "Sign in with Microsoft". The secret comes from Key Vault in Azure.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# The client's own Microsoft organisation (Entra tenant ID). Its members with the
# "Operator" app role can use the operator console.
OPERATOR_ENTRA_TENANT_ID=
# For the demo (docs/demo.md): "Sign in as the local operator" on /operator/sign-in, with
# no Microsoft account. Only works while AUTH_URL is local; never on a deployment.
DEV_OPERATOR_SIGN_IN=true

# Google Workspace SSO for tenants: an OAuth client in the client's Google Cloud project
# (redirect URI {AUTH_URL}/api/auth/callback/google). Leave empty if no tenant uses
# Google. The secret comes from Key Vault in Azure.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email links. "dev-outbox" writes messages to apps/web/.dev-outbox/ instead of sending them,
# and only works when AUTH_URL is local. In Azure use "acs" (Azure Communication
# Services); the connection string comes from Key Vault.
EMAIL_TRANSPORT=dev-outbox
ACS_CONNECTION_STRING=
EMAIL_FROM=

# Models (task 8, docs/models.md). "demo" (task 15) is no model at all: it recognises the
# sample contracts in samples/files and answers with their recorded example answers, and
# refuses anything else (model-demo-unknown). It only works with a local DATABASE_URL.
# For real answers, set MODEL_PROVIDER to azure-openai or bedrock instead. Unset, every
# job fails with "no-model".
MODEL_PROVIDER=demo
# MODEL_PROVIDER=azure-openai
# AZURE_OPENAI_ENDPOINT=https://<account>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_MODEL=            # the deployed model's name, for prices and records
#   (sign in with `az login`; the account allows no keys)
# AZURE_OPENAI_API_VERSION=      # optional; default v1 (or a dated version)
# AZURE_OPENAI_API_KEY=          # only for an account that allows keys (ours do not)
# MODEL_PROVIDER=bedrock
# BEDROCK_REGION=eu-west-2
# BEDROCK_MODEL_ID=
# BEDROCK_API_KEY=               # a Bedrock API key; never commit it
# BEDROCK_ENDPOINT=              # tests only: a local fake of Bedrock (refused otherwise)

# Task 14. Application Insights: set in Azure by the Bicep; leave unset locally (no
# telemetry is sent). The apps' event lines still go to standard output.
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# The audit log's write-once copy: in Azure, the audit storage account's URL (set by the
# Bicep). Unset locally, it goes to an "audit" container in Azurite instead.
# AUDIT_STORAGE_ACCOUNT_URL=
